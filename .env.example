# Copy to .env and fill in your Neon connection string.
# DATABASE_URL is a server-side secret. Do not prefix it with VITE_ and do not
# use it directly from browser code.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require&channel_binding=require

# Password to view the "Results history" screen. This ships in the client
# bundle, so treat it as a casual gate (keeps casual students out), not real
# authentication.
VITE_RESULTS_PASSWORD=choose-a-password
